diff --git a/src/drivers/sdl/lv_sdl_mouse.c b/src/drivers/sdl/lv_sdl_mouse.c
index a401c12..d99a80e 100644
--- a/src/drivers/sdl/lv_sdl_mouse.c
+++ b/src/drivers/sdl/lv_sdl_mouse.c
@@ -133,7 +133,12 @@ void lv_sdl_mouse_handler(SDL_Event * event)
     /*Find a suitable indev*/
     lv_indev_t * indev = lv_indev_get_next(NULL);
     while(indev) {
-        if(lv_indev_get_read_cb(indev) == sdl_mouse_read) {
+        /*The app may have wrapped this indev's read_cb (e.g. to intercept
+         *presses while the screen is off), so the read_cb is no longer
+         *literally sdl_mouse_read. Falling back to POINTER type still
+         *identifies it correctly, since lv_sdl_mouse_create() is the only
+         *thing that ever registers a pointer-type indev here.*/
+        if(lv_indev_get_read_cb(indev) == sdl_mouse_read || lv_indev_get_type(indev) == LV_INDEV_TYPE_POINTER) {
             /*If disp is NULL for any reason use the first indev with the correct type*/
             if(disp == NULL || lv_indev_get_display(indev) == disp) break;
         }
